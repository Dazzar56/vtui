        "spacing": { "type": "int", "default": 1, "summary": "Интервал между строками" },
        "margins": { "type": "rect", "default": [0, 0, 0, 0], "summary": "Отступы" }
      }
    },
    "Stack": {
      "summary": "Многослойный контейнер (показывает одного потомка)",
      "properties": {
        "currentIndex": { "type": "int", "default": 0, "summary": "Индекс активного слоя" }
      }
    },
    "Absolute": {
      "summary": "Классическое абсолютное позиционирование с GrowMode",
      "properties": {}
    }
