        "spacing": { "type": "rect", "default": [1, 1], "summary": "Интервалы по горизонтали и вертикали" },
        "margins": { "type": "rect", "default": [0, 0, 0, 0], "summary": "Отступы сетки" }
      }
    },
    "Form": {
      "summary": "Двухколоночная раскладка форма (метка + поле)",
