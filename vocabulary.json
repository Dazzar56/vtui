{
  "version": 1,
  "widgets": {
    "Widget": {
      "summary": "Базовый абстрактный компонент",
      "properties": {
        "id": { "type": "string", "default": "", "summary": "Уникальный строковый идентификатор элемента" },
        "visible": { "type": "bool", "default": true, "summary": "Видимость элемента" },
        "enabled": { "type": "bool", "default": true, "summary": "Доступность для взаимодействия" },
        "help": { "type": "string", "default": "", "summary": "Идентификатор контекстной справки F1" },
        "grow": { "type": "int", "default": 0, "summary": "Флаги GrowMode для абсолютной раскладки" },
        "align": { "type": "string", "default": "fill", "summary": "Выравнивание внутри ячейки раскладки (fill, start, center, end)" },
        "stretch": { "type": "int", "default": 1, "summary": "Вес растяжения при распределении свободного места" },
        "minWidth": { "type": "int", "default": 0, "summary": "Минимальная ширина в ячейках" },
        "minHeight": { "type": "int", "default": 0, "summary": "Минимальная высота в ячейках" },
        "maxWidth": { "type": "int", "default": 0, "summary": "Максимальная ширина (0 - без ограничения)" },
        "maxHeight": { "type": "int", "default": 0, "summary": "Максимальная высота (0 - без ограничения)" }
      },
      "signals": ["focus", "blur"]
    },
    "Dialog": {
      "extends": "Widget",
      "summary": "Модальное диалоговое окно",
      "properties": {
        "title": { "type": "string", "default": "", "summary": "Заголовок диалога" },
        "showClose": { "type": "bool", "default": true, "summary": "Показывать кнопку закрытия [x]" },
        "showZoom": { "type": "bool", "default": false, "summary": "Показывать кнопку разворачивания" },
        "isWarning": { "type": "bool", "default": false, "summary": "Использовать предупреждающую (красную) палитру" },
        "autoSize": { "type": "bool", "default": false, "summary": "Автоматически вычислить размер по содержимому" },
        "center": { "type": "bool", "default": true, "summary": "Центрировать окно на экране" }
      },
      "signals": ["closed"],
      "localizable": ["title"],
      "sizeHint": { "w": 40, "h": 10 },
      "minSize": { "w": 10, "h": 5 },
      "sizePolicy": { "h": "preferred", "v": "preferred" }
    },
    "Window": {
      "extends": "Widget",
      "summary": "Немодальное перемещаемое окно",
      "properties": {
        "title": { "type": "string", "default": "", "summary": "Заголовок окна" },
        "showClose": { "type": "bool", "default": true, "summary": "Показывать кнопку закрытия [x]" },
        "showZoom": { "type": "bool", "default": true, "summary": "Показывать кнопку разворачивания [↕]" }
      },
      "signals": ["closed"],
      "localizable": ["title"],
      "sizeHint": { "w": 60, "h": 20 },
      "minSize": { "w": 10, "h": 5 },
      "sizePolicy": { "h": "preferred", "v": "preferred" }
    },
    "BorderedFrame": {
      "extends": "Widget",
      "summary": "Одиночная или двойная рамка с заголовком",
      "properties": {
        "title": { "type": "string", "default": "", "summary": "Заголовок рамки" },
        "boxType": { "type": "int", "default": 2, "summary": "Тип рамки: 1 (SingleBox) или 2 (DoubleBox)" },
        "showClose": { "type": "bool", "default": false, "summary": "Показывать кнопку закрытия" }
      },
      "signals": [],
      "localizable": ["title"],
      "sizeHint": { "w": 20, "h": 5 },
      "minSize": { "w": 4, "h": 3 },
      "sizePolicy": { "h": "preferred", "v": "preferred" }
    },
    "GroupBox": {
      "extends": "Widget",
      "summary": "Группа элементов в рамке с заголовком",
      "properties": {
        "title": { "type": "string", "default": "", "summary": "Заголовок группы" }
      },
      "signals": [],
      "localizable": ["title"],
      "sizeHint": { "w": 20, "h": 6 },
      "minSize": { "w": 6, "h": 3 },
      "sizePolicy": { "h": "expanding", "v": "preferred" }
    },
    "Button": {
      "extends": "Widget",
      "summary": "Кнопка действия",
      "properties": {
        "text": { "type": "string", "default": "&Ok", "summary": "Текст кнопки с мнемоникой (&)" },
        "default": { "type": "bool", "default": false, "summary": "Кнопка по умолчанию (срабатывает на Enter)" },
        "command": { "type": "int", "default": 0, "summary": "Команда для отправки при нажатии" }
      },
      "signals": ["clicked"],
      "localizable": ["text"],
      "sizeHint": { "w": 10, "h": 1 },
      "minSize": { "w": 6, "h": 1 },
      "sizePolicy": { "h": "fixed", "v": "fixed" }
    },
    "Checkbox": {
      "extends": "Widget",
      "summary": "Флажок с 2 или 3 состояниями",
      "properties": {
        "text": { "type": "string", "default": "", "summary": "Текст флажка с мнемоникой" },
        "state": { "type": "int", "default": 0, "summary": "0 - снят, 1 - установлен, 2 - неопределен" },
        "threeState": { "type": "bool", "default": false, "summary": "Поддержка третьего состояния" }
      },
      "signals": ["changed"],
      "localizable": ["text"],
      "sizeHint": { "w": 16, "h": 1 },
      "minSize": { "w": 6, "h": 1 },
      "sizePolicy": { "h": "preferred", "v": "fixed" }
    },
    "RadioButton": {
      "extends": "Widget",
      "summary": "Одиночный радио-переключатель",
      "properties": {
        "text": { "type": "string", "default": "", "summary": "Текст радиокнопки с мнемоникой" },
        "selected": { "type": "bool", "default": false, "summary": "Выбрана ли радиокнопка" }
      },
      "signals": ["changed"],
      "localizable": ["text"],
      "sizeHint": { "w": 16, "h": 1 },
      "minSize": { "w": 6, "h": 1 },
      "sizePolicy": { "h": "preferred", "v": "fixed" }
    },
    "RadioGroup": {
      "extends": "Widget",
      "summary": "Кластер взаимоисключающих радиокнопок",
      "properties": {
        "items": { "type": "stringList", "default": [], "summary": "Список вариантов" },
        "selected": { "type": "int", "default": 0, "summary": "Индекс выбранного элемента" },
        "columns": { "type": "int", "default": 1, "summary": "Число колонок сетки" }
      },
      "signals": ["changed"],
      "localizable": ["items"],
      "sizeHint": { "w": 20, "h": 3 },
      "minSize": { "w": 8, "h": 1 },
      "sizePolicy": { "h": "preferred", "v": "preferred" }
    },
    "CheckGroup": {
      "extends": "Widget",
      "summary": "Кластер независимых флажков в сетке",
      "properties": {
        "items": { "type": "stringList", "default": [], "summary": "Список названий флажков" },
        "data": { "type": "int", "default": 0, "summary": "Битовая маска состояний флажков" },
        "columns": { "type": "int", "default": 1, "summary": "Число колонок сетки" }
      },
      "signals": ["changed"],
      "localizable": ["items"],
      "sizeHint": { "w": 20, "h": 3 },
      "minSize": { "w": 8, "h": 1 },
      "sizePolicy": { "h": "preferred", "v": "preferred" }
    },
    "Edit": {
      "extends": "Widget",
      "summary": "Однострочное текстовое поле ввода",
      "properties": {
        "text": { "type": "string", "default": "", "summary": "Введённый текст" },
        "password": { "type": "bool", "default": false, "summary": "Маскировать пароль звёздочками" },
        "historyId": { "type": "string", "default": "", "summary": "Идентификатор списка истории" },
        "showHistoryButton": { "type": "bool", "default": false, "summary": "Показывать стрелку выпадающей истории [v]" }
      },
      "signals": ["changed", "activated"],
      "localizable": ["text"],
      "sizeHint": { "w": 20, "h": 1 },
      "minSize": { "w": 3, "h": 1 },
      "sizePolicy": { "h": "expanding", "v": "fixed" }
    },
    "MultiLineEdit": {
      "extends": "Widget",
      "summary": "Многострочное поле ввода текста",
      "properties": {
        "text": { "type": "string", "default": "", "summary": "Текст поля с переносами строк" }
      },
      "signals": ["changed"],
      "localizable": ["text"],
      "sizeHint": { "w": 30, "h": 5 },
      "minSize": { "w": 10, "h": 2 },
      "sizePolicy": { "h": "expanding", "v": "expanding" }
    },
    "Label": {
      "extends": "Widget",
      "summary": "Текстовая метка, связанная с полем ввода",
      "properties": {
        "text": { "type": "string", "default": "", "summary": "Текст метки с мнемоникой" },
        "buddy": { "type": "string", "default": "", "summary": "ID связанного поля ввода" }
