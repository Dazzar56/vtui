      "signals": [],
      "localizable": ["text"],
      "sizeHint": { "w": 10, "h": 1 },
      "minSize": { "w": 1, "h": 1 },
      "sizePolicy": { "h": "preferred", "v": "fixed" }
    },
    "Text": {
      "extends": "Widget",
      "summary": "Простая статическая текстовая надпись",
      "properties": {
        "text": { "type": "string", "default": "", "summary": "Отображаемый текст" }
      },
      "signals": [],
      "localizable": ["text"],
      "sizeHint": { "w": 10, "h": 1 },
      "minSize": { "w": 1, "h": 1 },
      "sizePolicy": { "h": "preferred", "v": "fixed" }
    },
    "ListBox": {
      "extends": "Widget",
      "summary": "Одноколоночный список строк",
      "properties": {
        "items": { "type": "stringList", "default": [], "summary": "Список отображаемых строк" },
        "selected": { "type": "int", "default": 0, "summary": "Индекс выбранной строки" },
        "multiSelect": { "type": "bool", "default": false, "summary": "Множественный выбор" }
      },
      "signals": ["selected", "activated"],
      "localizable": ["items"],
      "sizeHint": { "w": 20, "h": 8 },
      "minSize": { "w": 5, "h": 3 },
      "sizePolicy": { "h": "expanding", "v": "expanding" }
    },
    "ComboBox": {
      "extends": "Widget",
      "summary": "Выпадающий список с возможностью ввода",
      "properties": {
        "text": { "type": "string", "default": "", "summary": "Текущий текст в поле" },
        "items": { "type": "stringList", "default": [], "summary": "Список вариантов выбора" },
        "dropdownOnly": { "type": "bool", "default": false, "summary": "Запретить ручной ввод (только выбор из списка)" }
      },
      "signals": ["changed", "selected"],
      "localizable": ["items", "text"],
      "sizeHint": { "w": 20, "h": 1 },
      "minSize": { "w": 6, "h": 1 },
      "sizePolicy": { "h": "expanding", "v": "fixed" }
    },
    "Table": {
      "extends": "Widget",
      "summary": "Многоколоночная таблица",
      "properties": {
        "showHeader": { "type": "bool", "default": true, "summary": "Показывать заголовки колонок" },
        "showSeparators": { "type": "bool", "default": true, "summary": "Показывать вертикальные разделители колонок" },
        "sortable": { "type": "bool", "default": false, "summary": "Включить сортировку по клику на заголовок" },
        "quickSearch": { "type": "bool", "default": false, "summary": "Включить быстрый fuzzy-поиск" },
        "selected": { "type": "int", "default": 0, "summary": "Индекс выбранной строки" }
      },
      "signals": ["selected", "activated"],
      "sizeHint": { "w": 40, "h": 10 },
      "minSize": { "w": 10, "h": 4 },
      "sizePolicy": { "h": "expanding", "v": "expanding" }
    },
    "VMenu": {
      "extends": "Widget",
      "summary": "Вертикальное контекстное или всплывающее меню",
      "properties": {
        "title": { "type": "string", "default": "", "summary": "Заголовок меню" },
        "selected": { "type": "int", "default": 0, "summary": "Индекс выбранного пункта" }
      },
      "signals": ["selected", "activated"],
      "localizable": ["title"],
      "sizeHint": { "w": 20, "h": 8 },
      "minSize": { "w": 8, "h": 3 },
      "sizePolicy": { "h": "preferred", "v": "preferred" }
    },
    "MenuBar": {
      "extends": "Widget",
      "summary": "Верхняя горизонтальная строка меню",
      "properties": {},
      "signals": ["activated"],
      "sizeHint": { "w": 80, "h": 1 },
      "minSize": { "w": 10, "h": 1 },
      "sizePolicy": { "h": "expanding", "v": "fixed" }
    },
    "KeyBar": {
      "extends": "Widget",
      "summary": "Нижняя строка функциональных клавиш F1-F12",
      "properties": {},
      "signals": ["clicked"],
      "sizeHint": { "w": 80, "h": 1 },
      "minSize": { "w": 36, "h": 1 },
      "sizePolicy": { "h": "expanding", "v": "fixed" }
    },
    "StatusLine": {
      "extends": "Widget",
      "summary": "Контекстная строка состояния и подсказок горячих клавиш",
      "properties": {},
      "signals": [],
      "sizeHint": { "w": 80, "h": 1 },
      "minSize": { "w": 10, "h": 1 },
      "sizePolicy": { "h": "expanding", "v": "fixed" }
    },
    "ProgressBar": {
      "extends": "Widget",
      "summary": "Индикатор прогресса",
      "properties": {
        "percent": { "type": "int", "default": 0, "summary": "Процент завершения от 0 до 100" }
      },
      "signals": [],
      "sizeHint": { "w": 20, "h": 1 },
      "minSize": { "w": 5, "h": 1 },
      "sizePolicy": { "h": "expanding", "v": "fixed" }
    },
    "Separator": {
      "extends": "Widget",
      "summary": "Горизонтальная разделительная линия",
      "properties": {
        "connectLeft": { "type": "bool", "default": true, "summary": "Присоединять левый край к рамке" },
        "connectRight": { "type": "bool", "default": true, "summary": "Присоединять правый край к рамке" }
      },
      "signals": [],
      "sizeHint": { "w": 20, "h": 1 },
      "minSize": { "w": 2, "h": 1 },
      "sizePolicy": { "h": "expanding", "v": "fixed" }
    },
    "Spacer": {
      "extends": "Widget",
      "summary": "Пружинящий разделитель свободного места в раскладке",
      "properties": {},
      "signals": [],
      "sizeHint": { "w": 1, "h": 1 },
      "minSize": { "w": 0, "h": 0 },
      "sizePolicy": { "h": "expanding", "v": "expanding" }
    },
    "Desktop": {
      "extends": "Widget",
      "summary": "Фоновый рабочий стол",
      "properties": {},
      "signals": [],
      "sizeHint": { "w": 80, "h": 25 },
      "minSize": { "w": 10, "h": 5 },
      "sizePolicy": { "h": "expanding", "v": "expanding" }
    }
  },
  "layouts": {
    "VBox": {
      "summary": "Вертикальное последовательное расположение элементов",
      "properties": {
        "spacing": { "type": "int", "default": 1, "summary": "Интервал между элементами" },
        "margins": { "type": "rect", "default": [0, 0, 0, 0], "summary": "Отступы [top, right, bottom, left]" }
      }
    },
    "HBox": {
      "summary": "Горизонтальное последовательное расположение элементов",
      "properties": {
        "spacing": { "type": "int", "default": 1, "summary": "Интервал между элементами" },
        "margins": { "type": "rect", "default": [0, 0, 0, 0], "summary": "Отступы [top, right, bottom, left]" },
        "align": { "type": "string", "default": "left", "summary": "Выравнивание всего блока (left, center, right)" }
      }
    },
    "Grid": {
      "summary": "Двумерная сеточная раскладка",
